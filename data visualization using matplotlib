import matplotlib.pyplot as plt

x = [1, 2, 3, 4, 5]
y = [10, 20, 15, 30, 25]

# Line Plot
plt.plot(x, y)
plt.title("Line Plot")
plt.show()

# Scatter Plot
plt.scatter(x, y)
plt.title("Scatter Plot")
plt.show()

# Bar Chart
plt.bar(x, y)
plt.title("Bar Chart")
plt.show()

# Box Plot
plt.boxplot(y)
plt.title("Box Plot")
plt.show()
