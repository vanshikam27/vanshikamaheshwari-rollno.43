import math

def calculate_area(shape, a, b=0):

    if shape == "circle":

        return math.pi * a * a

    elif shape == "rectangle":

        return a * b

    elif shape == "triangle":

        return 0.5 * a * b

shape = input("Enter shape (circle/rectangle/triangle): ").lower()

if shape == "circle":

    r = float(input("Enter radius: "))

    print("Area:", calculate_area(shape, r))

elif shape == "rectangle":

    l = float(input("Enter length: "))

    w = float(input("Enter width: "))

    print("Area:", calculate_area(shape, l, w))

elif shape == "triangle":

    base = float(input("Enter base: "))

    height = float(input("Enter height: "))

    print("Area:", calculate_area(shape, base, height))

else:

    print("Invalid shape")
